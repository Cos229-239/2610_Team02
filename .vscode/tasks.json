{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TowerFlow: Start local server",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/TowerFlow/server.js"
      ],
      "options": {
        "cwd": "${workspaceFolder}/TowerFlow",
        "env": {
          "PORT": "4174"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "towerflow",
        "pattern": {
          "regexp": "^(.*)$",
          "kind": "file",
          "file": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^TowerFlow server listening at",
          "endsPattern": "^TowerFlow server listening at http://127\\.0\\.0\\.1:4174$"
        }
      }
    },
    {
      "label": "TowerFlow: Check contribution",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/tools/check-contributions.cjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
